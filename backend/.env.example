LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=your-local-key
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=25
# Optional. Only for HTTPS Provider gateway hostnames under your DNS control
# that intentionally resolve to private/reserved IPs. Exact hostnames only; no IPs/secrets.
# LLM_PROVIDER_PRIVATE_HOST_ALLOWLIST=your-private-gateway.example
