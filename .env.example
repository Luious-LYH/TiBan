# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8002

# Backend
ENDO_APP_ENV=demo
ENDO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep false for the public compact teaching seed. Set true only when locally
# validating an already authorized external sample dataset.
ENDO_DEMO_QBANK_BOOTSTRAP=false
# Local checkout's ignored/externalized data roots. Docker maps these to
# /app/data and /app/vqa-data; set the host path in .env when it differs.
ENDO_LOCAL_VQA_HOST_ROOT=/absolute/path/to/VQA/data
ENDO_LOCAL_VQA_ROOT=/absolute/path/to/VQA/data
ENDO_PROJECT_DATA_ROOT=/absolute/path/to/Endoscopy_Agent/code/data

# Hosted intelligent-service configuration. Do not commit real keys.
# Call order: Cloudflare Workers AI -> OpenRouter -> BigModel.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
BIGMODEL_API_KEY=
BIGMODEL_MODEL=GLM-5.3-Flash
# Optional generic overrides. Leave blank to use the provider chain above.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FINAL_FALLBACK_PROVIDER=
LLM_FINAL_FALLBACK_BASE_URL=
LLM_FINAL_FALLBACK_API_KEY=
LLM_FINAL_FALLBACK_MODEL=
model_reasoning_effort=
TUTOR_PROVIDER_ENABLED=true
# Keep false unless a locally controlled private-network Provider is configured.
LLM_PROVIDER_ALLOW_PRIVATE_NETWORK=false
LLM_TIMEOUT_SECONDS=25
# Factory defaults to the visibly labelled deterministic adapter. Set to true
# only for a deliberate provider-backed generation/judge run; it never falls
# back to an alternate provider when enabled.
FACTORY_PROVIDER_ENABLED=false

# Derived Knowledge and Learning Memory indexes. The default is SiliconFlow
# BGE-M3; source data remains intact if an index must later be rebuilt.
EMBEDDING_MODE=api
EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODE=api
RERANKER_PROVIDER=siliconflow
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
