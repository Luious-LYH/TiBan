# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend
ENDO_APP_ENV=demo
ENDO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OpenAI-compatible model provider.
